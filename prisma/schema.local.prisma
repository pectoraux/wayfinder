// Wayfinder — Prisma schema (SQLite, LOCAL DEV ONLY)
//
// This is the LOCAL DEVELOPMENT schema. It mirrors prisma/schema.prisma but uses
// SQLite so local dev/tests work without a PostgreSQL instance.
// (via the --schema flag) when no PostgreSQL instance is available. The field
// definitions are identical between the two; only the provider differs.
//
// The immigration KNOWLEDGE BASE (countries, pathways, policy rules, evidence,
// enablers) lives in versioned TypeScript modules under src/lib/knowledge so it
// is deterministic and reproducible. This database stores USER-SCOPED data:
// auth identities, waitlist, mobility-state snapshots, intent versions,
// reproducible decision records, counterfactual scenarios, and consent.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTH
// ---------------------------------------------------------------------------

/// Role-based access. ADMIN can approve the waitlist and create accounts.
/// USER is a real approved user. DEMO is a showcase account with quick-login.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  persons        Person[]
  waitlist       WaitlistEntry[]
  mobileSessions MobileSession[]
}

enum Role {
  USER
  ADMIN
  DEMO
}

/// Sign-ups land here pending admin approval. On approval, a User account is
/// created and the entry is linked.
model WaitlistEntry {
  id        String           @id @default(cuid())
  email     String           @unique
  name      String?
  intent    String?          // what they want to make possible
  status    WaitlistStatus   @default(PENDING)
  userId    String?          // set when an account is created
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
}

enum WaitlistStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// MOBILITY PROFILE (existing domain — linked to auth User)
// ---------------------------------------------------------------------------

/// A person using Wayfinder. Linked to an auth User when authenticated.
model Person {
  id          String   @id @default(cuid())
  userId      String?  // optional link to auth User (null for anonymous/legacy)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  states      MobilityStateSnapshot[]
  intents     IntentRecord[]
  decisions   DecisionRecord[]
  scenarios   Scenario[]
  consents    ConsentRecord[]

  @@index([userId])
}

/// A point-in-time snapshot of a person's real-world mobility state.
/// VERSION UNIQUENESS: @@unique([personId, version]) — DB-level backstop
/// for transactional MAX(version)+1 allocation.
model MobilityStateSnapshot {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  version     Int      @default(1)
  state       Json
  source      String   @default("intake")
  createdAt   DateTime @default(now())

  @@unique([personId, version])
  @@index([personId])
}

/// A versioned record of the user's expressed intent + inferred objectives.
/// VERSION UNIQUENESS: @@unique([personId, version]) — DB-level backstop.
model IntentRecord {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  version     Int      @default(1)
  rawInput    String
  intent      Json
  createdAt   DateTime @default(now())

  @@unique([personId, version])
  @@index([personId])
}

/// A reproducible decision record. Stores the FULL computed plan as JSON plus a
/// reference to the policy version that produced it, so the recommendation can
/// be reconstructed even after policy changes. NEVER overwritten.
model DecisionRecord {
  id              String   @id @default(cuid())
  personId        String
  person          Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  stateVersion    Int
  intentVersion   Int
  policyVersion   String
  policyHash      String
  /// The runtime policy version (base + overlays) this plan was computed under.
  runtimePolicyVersion String?
  runtimePolicyHash  String?
  asOfDate        DateTime
  plan            Json
  /// The previous plan version this one supersedes (for policy-triggered recomputation).
  previousRecordId String?
  /// What triggered this plan version: "intake" | "edit" | "POLICY_CHANGE" | "counterfactual" | "OBJECTIVE_ADOPT"
  trigger         String   @default("intake")
  /// The deterministic cause of this strategy change (N0.2 Strategy Memory).
  changeReason    String?
  /// The policy publication that triggered this recomputation, if any.
  policyPublicationId String?
  /// The PolicyEvent that triggered this recomputation, if policy-driven.
  policyEventId   String?
  /// The user who owns this plan (for alert generation).
  userId          String?
  /// Plan lifecycle status: ACTIVE (current), SUPERSEDED (replaced by a newer version), ARCHIVED (user dismissed)
  planStatus      String   @default("ACTIVE")
  /// The strategy engine version used to compute this plan's strategy.
  strategyEngineVersion String?
  /// The objective this plan was computed for (e.g., "income", "residence").
  objectiveId     String?
  /// The objective version (immutable objective/intention record version).
  objectiveVersion Int?
  /// The full strategy snapshot (JSON) at the time of computation.
  strategySnapshot Json?
  /// The MobilityStateSnapshot id this strategy was computed against.
  /// Together with stateVersion, this lets us reconstruct the exact profile.
  mobilityStateSnapshotId String?
  /// The IntentRecord id this strategy was computed against.
  /// Together with intentVersion, this lets us reconstruct the exact intent.
  intentRecordId  String?
  /// Sentinel for the partial unique constraint "at most one ACTIVE strategy
  /// per user + objective". Set to `${userId}:${objectiveId}` when planStatus
  /// = 'ACTIVE', NULL otherwise. Postgres treats NULLs as distinct, so multiple
  /// SUPERSEDED records can coexist without violating the constraint.
  uniqueActiveObjectiveKey String? @unique
  createdAt       DateTime @default(now())

  @@index([personId])
  @@index([policyPublicationId])
  @@index([policyEventId])
  @@index([userId])
  @@index([planStatus])
  @@index([userId, planStatus])
  @@index([userId, objectiveId])
  @@index([userId, objectiveId, planStatus])
  @@index([mobilityStateSnapshotId])
  @@index([intentRecordId])
}

/// A counterfactual "What if?" simulation: modified state -> recomputed plan.
model Scenario {
  id            String   @id @default(cuid())
  personId      String
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  label         String
  baseStateVersion  Int
  modifiedState Json
  deltaSummary  String
  plan          Json
  frontierDelta Json
  createdAt     DateTime @default(now())

  @@index([personId])
}

/// Explicit consent records.
model ConsentRecord {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  purpose     String
  recipient   String
  dataFields  String
  granted     Boolean  @default(false)
  durationDays Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([personId])
}

// ---------------------------------------------------------------------------
// POLICY INTELLIGENCE — sources, snapshots, change detection
// ---------------------------------------------------------------------------

/// An authoritative source of immigration information (government page,
/// legislation, embassy, etc.). The knowledge base references Sources via
/// Evidence records.
model PolicySource {
  id            String   @id @default(cuid())
  jurisdictionId String
  sourceType    String   // GOVERNMENT_PAGE | LEGISLATION | REGULATION | ...
  authority     String
  name          String   @default("Unnamed source")
  url           String   @unique
  retrievalMethod String  @default("http_fetch")
  trustLevel    String   @default("OFFICIAL_SECONDARY")
  active        Boolean  @default(true)
  monitoringFrequencyHours Int @default(168)
  lastCheckedAt DateTime?
  lastSuccessfulFetchAt DateTime?
  evidenceIds   String   @default("[]") // JSON array of evidence ids
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  snapshots     SourceSnapshot[]

  @@index([jurisdictionId])
  @@index([active])
}

/// A snapshot of a source's content at a point in time. Enables change
/// detection (content-hash diff) without depending on the live webpage.
model SourceSnapshot {
  id            String   @id @default(cuid())
  sourceId      String
  source        PolicySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  retrievedAt   DateTime @default(now())
  contentHash   String
  contentType   String   @default("")
  contentLength Int      @default(0)
  retrievalStatus String @default("OK")
  statusCode    Int?
  rawStorageLocation String @default("inline")
  parserVersion String   @default("1.0")
  changeType    String?  // UNCHANGED | TEXT_CHANGED | STRUCTURAL_CHANGED | POSSIBLE_POLICY_CHANGE | LIKELY_POLICY_CHANGE | VERIFIED_POLICY_CHANGE | FETCH_ERROR
  diffSummary   String?
  content       String?

  candidates    CandidateFact[]

  @@index([sourceId])
  @@index([changeType])
}

/// An AI-extracted candidate policy change. Enters as AI_EXTRACTED and
/// CANNOT become authoritative until a human approves it (status=APPROVED).
model CandidateFact {
  id            String   @id @default(cuid())
  sourceSnapshotId String
  sourceSnapshot SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Cascade)
  jurisdictionId String
  entityType    String   // requirement | program | transition | status
  entityId      String?
  entityLabel   String
  changeKind    String   // threshold_changed | requirement_added | program_suspended | ...
  field         String?
  oldValue      String?  // JSON-serialized
  newValue      String?  // JSON-serialized
  effectiveFrom String?
  effectiveTo   String?
  evidence      String
  sourceUrl     String
  model         String   @default("z-ai-web-dev-sdk")
  promptVersion String   @default("1.0")
  confidence    Float    @default(0)
  extractionStatus String @default("AI_EXTRACTED") // AI_EXTRACTED | PENDING_REVIEW | APPROVED | REJECTED | NEEDS_MORE_EVIDENCE | DUPLICATE | SUPERSEDED
  aiInterpretation String?
  createdAt     DateTime @default(now())
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?

  @@index([extractionStatus])
  @@index([jurisdictionId])
}

/// A record of a policy version publication — the output of approving a
/// candidate fact. Never mutates an existing published version.
model PolicyPublication {
  id            String   @id @default(cuid())
  policyVersionId String
  parentVersionId String
  candidateFactIds String // JSON array
  approvedBy    String
  approvedAt    DateTime @default(now())
  contentHash   String
  provenance    String   @default("AUTHORITATIVE")
  consistencyChecks String // JSON array of {name, passed, details}
  notes         String
  /// Lifecycle state. Only PUBLISHED publications are active in the runtime.
  status        String   @default("PUBLISHED") // DRAFT | PUBLISHED | SUPERSEDED | ROLLED_BACK | INVALIDATED
  /// The overlay JSON (the changes this publication applies).
  overlay       String?  // JSON-serialized PolicyOverlay
  /// Rollback tracking.
  rolledBackAt  DateTime?
  rolledBackBy  String?
  rollbackReason String?
  /// The jurisdiction this publication affects.
  jurisdictionId String @default("global")

  @@index([policyVersionId])
  @@index([status])
  @@index([jurisdictionId])
}

/// Audit log for every admin action in the policy console.
model AdminAuditRecord {
  id            String   @id @default(cuid())
  adminId       String
  adminEmail    String
  action        String   // APPROVE_CANDIDATE | REJECT_CANDIDATE | PUBLISH_POLICY_VERSION | ...
  entityId      String
  entityType    String
  before        String?  // JSON
  after         String?  // JSON
  timestamp     DateTime @default(now())
  reason        String?

  @@index([adminId])
  @@index([action])
}

/// A user's policy watchlist — they follow a country/program/route and get
/// notified when a verified change affects it.
model PolicyWatchlist {
  id            String   @id @default(cuid())
  userId        String
  watchType     String   // country | program | route
  watchId       String
  watchLabel    String
  createdAt     DateTime @default(now())

  @@unique([userId, watchType, watchId])
  @@index([userId])
}

/// A user-facing policy alert, generated only when a VERIFIED policy change
/// materially affects a user's saved plan or watchlist.
model PolicyAlert {
  id            String   @id @default(cuid())
  userId        String
  decisionRecordId String?
  policyPublicationId String?
  policyChangeId String
  /// The canonical PolicyEvent this alert is about. This is the single source
  /// of truth — the alert references the event, not a separate representation.
  policyEventId String?
  impactLevel   String
  severity      String   @default("NOTICE")
  title         String
  whatChanged   String
  whyItMatters  String
  recommendedAction String
  alternativeRoutes String?
  body          String
  idempotencyKey String @unique
  read          Boolean  @default(false)
  readAt        DateTime?
  dismissedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([severity])
  @@index([policyEventId])
}

/// Durable record tracking the policy propagation process itself. Persists
/// across crashes, restarts, and timeouts. Supports resumable cursor-based
/// processing.
model PolicyPropagation {
  id              String   @id @default(cuid())
  publicationId   String
  /// PENDING | RUNNING | COMPLETE | PARTIAL | FAILED
  status          String   @default("PENDING")
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  /// Total count of affected plans discovered
  totalAffectedPlans  Int  @default(0)
  /// How many have been processed (succeeded or failed)
  processedPlans  Int      @default(0)
  /// How many were successfully recomputed
  recomputedPlans Int      @default(0)
  /// How many alerts were created
  alertsCreated   Int      @default(0)
  /// How many individual plan recomputations failed
  errorCount      Int      @default(0)
  errorSummary    String?

  /// Cursor for resumable processing: the id of the last processed record
  lastProcessedRecordId String?
  lastProcessedAt       DateTime?

  /// Which attempt this is (incremented on resume)
  attempt         Int      @default(1)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([publicationId])
  @@index([status])
}

/// A first-class, user-facing representation of a verified policy change.
/// Created when a PolicyPublication is published. Referenced by alerts,
/// watchlists, route history, plan history, and the policy explorer.
/// Never created directly from AI extraction.
model PolicyEvent {
  id              String   @id @default(cuid())
  publicationId   String
  candidateFactId String
  jurisdictionId  String
  entityType      String   // requirement | program | transition | status
  entityId        String
  entityLabel     String
  changeType      String   // threshold_changed | requirement_added | program_suspended | ...
  title           String
  summary         String
  oldValue        String?  // JSON
  newValue        String?  // JSON
  effectiveFrom   String
  effectiveTo     String?
  sourceSnapshotId String?
  evidence        String
  sourceUrl       String
  provenance      String   @default("AUTHORITATIVE")
  status          String   @default("PUBLISHED") // PUBLISHED | SUPERSEDED | CORRECTED
  supersededByEventId String?
  createdAt       DateTime @default(now())
  publishedAt     DateTime?

  @@index([publicationId])
  @@index([jurisdictionId])
  @@index([status])
  @@index([entityId])
  @@index([provenance])
}

/// A user's persisted preference answer. Each answer creates a new intent
/// version and can trigger strategy recomputation.
model UserPreference {
  id            String   @id @default(cuid())
  userId        String
  questionId    String
  answer        String
  source        String   @default("user_answer")
  confidence    Float    @default(1.0)
  intentVersion Int
  createdAt     DateTime @default(now())

  @@unique([userId, questionId, intentVersion])
  @@index([userId])
}

/// A user's execution state for a strategy action. Separate from the
/// deterministic Action template — tracks what the user has actually done.
model UserAction {
  id            String   @id @default(cuid())
  userId        String
  actionId      String
  title         String
  description   String
  status        String   @default("NOT_STARTED")
  startedAt     DateTime?
  completedAt   DateTime?
  blockedReason String?
  strategyEngineVersion String?
  runtimePolicyHash String?
  decisionRecordId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, actionId])
  @@index([userId])
  @@index([status])
  @@index([decisionRecordId])
}


// ---------------------------------------------------------------------------
// N0.4 — STRATEGY FEEDBACK + OUTCOME TRACKING (mirrors schema.prisma)
// ---------------------------------------------------------------------------

model StrategyFeedback {
  id              String   @id @default(cuid())
  userId          String
  decisionRecordId String
  usefulness      Int?
  assumptionAccuracy Int?
  explanationAccuracy Int?
  blockerAccuracy Int?
  confidenceAssessment Int?
  freeText        String?
  createdAt       DateTime @default(now())
  @@index([userId])
  @@index([decisionRecordId])
  @@index([createdAt])
}

model ActionOutcome {
  id              String   @id @default(cuid())
  userId          String
  userActionId    String
  decisionRecordId String?
  outcomeType     OutcomeType @default(UNKNOWN)
  graphNodeId     String?
  expectedByDate  DateTime?
  confidence      Float?
  confidenceLevel ConfidenceLevel?
  expectedOutcomeId String?
  expectedOutcome  ActionOutcome? @relation("ActionOutcomeExpectedToObserved", fields: [expectedOutcomeId], references: [id], onDelete: NoAction)
  observedOutcomes ActionOutcome[] @relation("ActionOutcomeExpectedToObserved")
  evaluationStatus OutcomeEvaluationStatus @default(UNKNOWN)
  predictedEffect String?
  actualEffect    String?
  predictedDurationMonths Float?
  actualDurationMonths     Float?
  predictedCostUSD Float?
  actualCostUSD    Float?
  predictedBlockerResolved Boolean?
  actualBlockerResolved    Boolean?
  status          String   @default("UNKNOWN")
  provenance      String   @default("USER_REPORTED")
  notes           String?
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([userId])
  @@index([userActionId])
  @@index([decisionRecordId])
  @@index([status])
  @@index([provenance])
  @@index([outcomeType])
  @@index([evaluationStatus])
  @@index([expectedOutcomeId])
}

model StrategyOutcome {
  id              String   @id @default(cuid())
  userId          String
  decisionRecordId String
  objectiveId     String?
  outcomeType     OutcomeType @default(UNKNOWN)
  graphNodeId     String?
  confidence      Float?
  confidenceLevel ConfidenceLevel?
  expectedOutcomeId String?
  expectedOutcome  StrategyOutcome? @relation("StrategyOutcomeExpectedToObserved", fields: [expectedOutcomeId], references: [id], onDelete: NoAction)
  observedOutcomes StrategyOutcome[] @relation("StrategyOutcomeExpectedToObserved")
  evaluationStatus OutcomeEvaluationStatus @default(UNKNOWN)
  strategyFollowed String  @default("UNKNOWN")
  objectiveAchieved String @default("UNKNOWN")
  trajectoryBecameViable String @default("UNKNOWN")
  predictedTrajectoryViable Boolean?
  actualTrajectoryViable    Boolean?
  predictedTimelineMonths   Float?
  actualTimelineMonths      Float?
  predictedTotalCostUSD     Float?
  actualTotalCostUSD        Float?
  provenance      String   @default("USER_REPORTED")
  notes           String?
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([userId])
  @@index([decisionRecordId])
  @@index([objectiveId])
  @@index([strategyFollowed])
  @@index([provenance])
  @@index([outcomeType])
  @@index([evaluationStatus])
  @@index([expectedOutcomeId])
}

enum OutcomeType {
  ELIGIBILITY_OPENED
  ROUTE_UNLOCKED
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  RESIDENCE_GRANTED
  CITIZENSHIP_GRANTED
  CREDENTIAL_RECOGNIZED
  LANGUAGE_ACHIEVED
  CAPABILITY_ACQUIRED
  EMPLOYMENT_GAINED
  INCOME_CHANGED
  DOCUMENT_OBTAINED
  OTHER
  UNKNOWN
}

enum OutcomeEvaluationStatus {
  ACHIEVED
  PARTIALLY_ACHIEVED
  NOT_ACHIEVED
  UNKNOWN
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

model MobileSession {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  deviceId        String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  lastRotatedAt   DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}
