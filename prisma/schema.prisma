// Wayfinder — Prisma schema (PostgreSQL / Neon)
//
// This is the PRODUCTION schema. The datasource is PostgreSQL (Neon).
// Local development uses a separate SQLite schema at prisma/schema.local.prisma
// (via the --schema flag) when no PostgreSQL instance is available. The field
// definitions are identical between the two; only the provider differs.
//
// The immigration KNOWLEDGE BASE (countries, pathways, policy rules, evidence,
// enablers) lives in versioned TypeScript modules under src/lib/knowledge so it
// is deterministic and reproducible. This database stores USER-SCOPED data:
// auth identities, waitlist, mobility-state snapshots, intent versions,
// reproducible decision records, counterfactual scenarios, and consent.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")        // Neon pooled connection (runtime)
  directUrl = env("DIRECT_DATABASE_URL") // Neon direct connection (migrations)
}

// ---------------------------------------------------------------------------
// AUTH
// ---------------------------------------------------------------------------

/// Role-based access. ADMIN can approve the waitlist and create accounts.
/// USER is a real approved user. DEMO is a showcase account with quick-login.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  persons        Person[]
  waitlist       WaitlistEntry[]
}

enum Role {
  USER
  ADMIN
  DEMO
}

/// Sign-ups land here pending admin approval. On approval, a User account is
/// created and the entry is linked.
model WaitlistEntry {
  id        String           @id @default(cuid())
  email     String           @unique
  name      String?
  intent    String?          // what they want to make possible
  status    WaitlistStatus   @default(PENDING)
  userId    String?          // set when an account is created
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
}

enum WaitlistStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// MOBILITY PROFILE (existing domain — linked to auth User)
// ---------------------------------------------------------------------------

/// A person using Wayfinder. Linked to an auth User when authenticated.
model Person {
  id          String   @id @default(cuid())
  userId      String?  // optional link to auth User (null for anonymous/legacy)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  states      MobilityStateSnapshot[]
  intents     IntentRecord[]
  decisions   DecisionRecord[]
  scenarios   Scenario[]
  consents    ConsentRecord[]

  @@index([userId])
}

/// A point-in-time snapshot of a person's real-world mobility state.
///
/// VERSION UNIQUENESS: `@@unique([personId, version])` enforces at the DB
/// level that no two snapshots for the same person can share a version
/// number. This is the correctness backstop for the transactional
/// `MAX(version)+1` allocation in /api/profile — even if two concurrent
/// transactions both read the same max, only one can commit; the other
/// gets a unique-constraint violation and must retry.
model MobilityStateSnapshot {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  version     Int      @default(1)
  state       Json
  source      String   @default("intake")
  createdAt   DateTime @default(now())

  @@unique([personId, version])
  @@index([personId])
}

/// A versioned record of the user's expressed intent + inferred objectives.
///
/// VERSION UNIQUENESS: `@@unique([personId, version])` enforces at the DB
/// level that no two intent records for the same person can share a version.
/// Same backstop as MobilityStateSnapshot.
model IntentRecord {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  version     Int      @default(1)
  rawInput    String
  intent      Json
  createdAt   DateTime @default(now())

  @@unique([personId, version])
  @@index([personId])
}

/// A reproducible decision record. Stores the FULL computed plan as JSON plus a
/// reference to the policy version that produced it, so the recommendation can
/// be reconstructed even after policy changes. NEVER overwritten.
model DecisionRecord {
  id              String   @id @default(cuid())
  personId        String
  person          Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  stateVersion    Int
  intentVersion   Int
  policyVersion   String
  policyHash      String
  /// The runtime policy version (base + overlays) this plan was computed under.
  runtimePolicyVersion String?
  runtimePolicyHash  String?
  asOfDate        DateTime
  plan            Json
  /// The previous plan version this one supersedes (for policy-triggered recomputation).
  previousRecordId String?
  /// What triggered this plan version: "intake" | "edit" | "POLICY_CHANGE" | "counterfactual" | "OBJECTIVE_ADOPT"
  trigger         String   @default("intake")
  /// The deterministic cause of this strategy change (N0.2 Strategy Memory).
  /// One of: USER_PROFILE_CHANGED | USER_INTENT_CHANGED | OBJECTIVE_CHANGED |
  /// POLICY_CHANGED | ENGINE_CHANGED | MANUAL_ADOPTION | RECOMPUTATION | UNKNOWN
  /// Richer than `trigger` — classifies the actual cause of the transition
  /// from the previous strategy to this one.
  changeReason    String?
  /// The policy publication that triggered this recomputation, if any.
  policyPublicationId String?
  /// The PolicyEvent that triggered this recomputation, if policy-driven.
  /// Links to the canonical PolicyEvent (first-class domain object) so the
  /// user can see exactly which verified policy change caused this strategy
  /// to be recomputed.
  policyEventId   String?
  /// The user who owns this plan (for alert generation).
  userId          String?
  /// Plan lifecycle status: ACTIVE (current), SUPERSEDED (replaced by a newer version), ARCHIVED (user dismissed)
  planStatus      String   @default("ACTIVE")
  /// The strategy engine version used to compute this plan's strategy.
  strategyEngineVersion String?
  /// The objective this plan was computed for (e.g., "income", "residence").
  objectiveId     String?
  /// The objective version (immutable objective/intention record version).
  objectiveVersion Int?
  /// The full strategy snapshot (JSON) at the time of computation.
  strategySnapshot Json?
  /// The MobilityStateSnapshot id this strategy was computed against.
  /// Together with stateVersion, this lets us reconstruct the exact profile.
  mobilityStateSnapshotId String?
  /// The IntentRecord id this strategy was computed against.
  /// Together with intentVersion, this lets us reconstruct the exact intent.
  intentRecordId  String?
  /// Sentinel for the partial unique constraint "at most one ACTIVE strategy
  /// per user + objective". Set to `${userId}:${objectiveId}` when planStatus
  /// = 'ACTIVE', NULL otherwise. Postgres treats NULLs as distinct, so multiple
  /// SUPERSEDED records can coexist without violating the constraint.
  uniqueActiveObjectiveKey String? @unique
  createdAt       DateTime @default(now())

  @@index([personId])
  @@index([policyPublicationId])
  @@index([policyEventId])
  @@index([userId])
  @@index([planStatus])
  @@index([userId, planStatus])
  @@index([userId, objectiveId])
  @@index([userId, objectiveId, planStatus])
  @@index([mobilityStateSnapshotId])
  @@index([intentRecordId])
}

/// A counterfactual "What if?" simulation: modified state -> recomputed plan.
model Scenario {
  id            String   @id @default(cuid())
  personId      String
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  label         String
  baseStateVersion  Int
  modifiedState Json
  deltaSummary  String
  plan          Json
  frontierDelta Json
  createdAt     DateTime @default(now())

  @@index([personId])
}

/// Explicit consent records.
model ConsentRecord {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  purpose     String
  recipient   String
  dataFields  String
  granted     Boolean  @default(false)
  durationDays Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([personId])
}

// ---------------------------------------------------------------------------
// POLICY INTELLIGENCE — sources, snapshots, change detection
// ---------------------------------------------------------------------------

/// An authoritative source of immigration information (government page,
/// legislation, embassy, etc.). The knowledge base references Sources via
/// Evidence records.
model PolicySource {
  id            String   @id @default(cuid())
  jurisdictionId String
  sourceType    String   // GOVERNMENT_PAGE | LEGISLATION | REGULATION | ...
  authority     String
  name          String   @default("Unnamed source")
  url           String   @unique
  retrievalMethod String  @default("http_fetch")
  trustLevel    String   @default("OFFICIAL_SECONDARY")
  active        Boolean  @default(true)
  monitoringFrequencyHours Int @default(168)
  lastCheckedAt DateTime?
  lastSuccessfulFetchAt DateTime?
  evidenceIds   String   @default("[]") // JSON array of evidence ids
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  snapshots     SourceSnapshot[]

  @@index([jurisdictionId])
  @@index([active])
}

/// A snapshot of a source's content at a point in time. Enables change
/// detection (content-hash diff) without depending on the live webpage.
model SourceSnapshot {
  id            String   @id @default(cuid())
  sourceId      String
  source        PolicySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  retrievedAt   DateTime @default(now())
  contentHash   String
  contentType   String   @default("")
  contentLength Int      @default(0)
  retrievalStatus String @default("OK")
  statusCode    Int?
  rawStorageLocation String @default("inline")
  parserVersion String   @default("1.0")
  changeType    String?  // UNCHANGED | TEXT_CHANGED | STRUCTURAL_CHANGED | POSSIBLE_POLICY_CHANGE | LIKELY_POLICY_CHANGE | VERIFIED_POLICY_CHANGE | FETCH_ERROR
  diffSummary   String?
  content       String?

  candidates    CandidateFact[]

  @@index([sourceId])
  @@index([changeType])
}

/// An AI-extracted candidate policy change. Enters as AI_EXTRACTED and
/// CANNOT become authoritative until a human approves it (status=APPROVED).
model CandidateFact {
  id            String   @id @default(cuid())
  sourceSnapshotId String
  sourceSnapshot SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Cascade)
  jurisdictionId String
  entityType    String   // requirement | program | transition | status
  entityId      String?
  entityLabel   String
  changeKind    String   // threshold_changed | requirement_added | program_suspended | ...
  field         String?
  oldValue      String?  // JSON-serialized
  newValue      String?  // JSON-serialized
  effectiveFrom String?
  effectiveTo   String?
  evidence      String
  sourceUrl     String
  model         String   @default("z-ai-web-dev-sdk")
  promptVersion String   @default("1.0")
  confidence    Float    @default(0)
  extractionStatus String @default("AI_EXTRACTED") // AI_EXTRACTED | PENDING_REVIEW | APPROVED | REJECTED | NEEDS_MORE_EVIDENCE | DUPLICATE | SUPERSEDED
  aiInterpretation String?
  createdAt     DateTime @default(now())
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?

  @@index([extractionStatus])
  @@index([jurisdictionId])
}

/// A record of a policy version publication — the output of approving a
/// candidate fact. Never mutates an existing published version.
model PolicyPublication {
  id            String   @id @default(cuid())
  policyVersionId String
  parentVersionId String
  candidateFactIds String // JSON array
  approvedBy    String
  approvedAt    DateTime @default(now())
  contentHash   String
  provenance    String   @default("AUTHORITATIVE")
  consistencyChecks String // JSON array of {name, passed, details}
  notes         String
  /// Lifecycle state. Only PUBLISHED publications are active in the runtime.
  status        String   @default("PUBLISHED") // DRAFT | PUBLISHED | SUPERSEDED | ROLLED_BACK | INVALIDATED
  /// The overlay JSON (the changes this publication applies).
  overlay       String?  // JSON-serialized PolicyOverlay
  /// Rollback tracking.
  rolledBackAt  DateTime?
  rolledBackBy  String?
  rollbackReason String?
  /// The jurisdiction this publication affects.
  jurisdictionId String @default("global")

  @@index([policyVersionId])
  @@index([status])
  @@index([jurisdictionId])
}

/// Audit log for every admin action in the policy console.
model AdminAuditRecord {
  id            String   @id @default(cuid())
  adminId       String
  adminEmail    String
  action        String   // APPROVE_CANDIDATE | REJECT_CANDIDATE | PUBLISH_POLICY_VERSION | ...
  entityId      String
  entityType    String
  before        String?  // JSON
  after         String?  // JSON
  timestamp     DateTime @default(now())
  reason        String?

  @@index([adminId])
  @@index([action])
}

/// A user's policy watchlist — they follow a country/program/route and get
/// notified when a verified change affects it.
model PolicyWatchlist {
  id            String   @id @default(cuid())
  userId        String
  watchType     String   // country | program | route
  watchId       String
  watchLabel    String
  createdAt     DateTime @default(now())

  @@unique([userId, watchType, watchId])
  @@index([userId])
}

/// A user-facing policy alert, generated only when a VERIFIED policy change
/// materially affects a user's saved plan or watchlist.
model PolicyAlert {
  id            String   @id @default(cuid())
  userId        String
  decisionRecordId String?
  policyPublicationId String?
  policyChangeId String
  /// The canonical PolicyEvent this alert is about. This is the single source
  /// of truth — the alert references the event, not a separate representation.
  policyEventId String?
  impactLevel   String
  severity      String   @default("NOTICE")
  title         String
  whatChanged   String
  whyItMatters  String
  recommendedAction String
  alternativeRoutes String?
  body          String
  idempotencyKey String @unique
  read          Boolean  @default(false)
  readAt        DateTime?
  dismissedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([severity])
  @@index([policyEventId])
}

/// Durable record tracking the policy propagation process itself. Persists
/// across crashes, restarts, and timeouts. Supports resumable cursor-based
/// processing.
model PolicyPropagation {
  id              String   @id @default(cuid())
  publicationId   String
  /// PENDING | RUNNING | COMPLETE | PARTIAL | FAILED
  status          String   @default("PENDING")
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  /// Total count of affected plans discovered
  totalAffectedPlans  Int  @default(0)
  /// How many have been processed (succeeded or failed)
  processedPlans  Int      @default(0)
  /// How many were successfully recomputed
  recomputedPlans Int      @default(0)
  /// How many alerts were created
  alertsCreated   Int      @default(0)
  /// How many individual plan recomputations failed
  errorCount      Int      @default(0)
  errorSummary    String?

  /// Cursor for resumable processing: the id of the last processed record
  lastProcessedRecordId String?
  lastProcessedAt       DateTime?

  /// Which attempt this is (incremented on resume)
  attempt         Int      @default(1)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([publicationId])
  @@index([status])
}

/// A first-class, user-facing representation of a verified policy change.
/// Created when a PolicyPublication is published. Referenced by alerts,
/// watchlists, route history, plan history, and the policy explorer.
/// Never created directly from AI extraction.
model PolicyEvent {
  id              String   @id @default(cuid())
  publicationId   String
  candidateFactId String
  jurisdictionId  String
  entityType      String   // requirement | program | transition | status
  entityId        String
  entityLabel     String
  changeType      String   // threshold_changed | requirement_added | program_suspended | ...
  title           String
  summary         String
  oldValue        String?  // JSON
  newValue        String?  // JSON
  effectiveFrom   String
  effectiveTo     String?
  sourceSnapshotId String?
  evidence        String
  sourceUrl       String
  provenance      String   @default("AUTHORITATIVE")
  status          String   @default("PUBLISHED") // PUBLISHED | SUPERSEDED | CORRECTED
  supersededByEventId String?
  createdAt       DateTime @default(now())
  publishedAt     DateTime?

  @@index([publicationId])
  @@index([jurisdictionId])
  @@index([status])
  @@index([entityId])
  @@index([provenance])
}

/// A user's persisted preference answer. Each answer creates a new intent
/// version and can trigger strategy recomputation.
model UserPreference {
  id            String   @id @default(cuid())
  userId        String
  questionId    String
  answer        String
  source        String   @default("user_answer")
  confidence    Float    @default(1.0)
  intentVersion Int
  createdAt     DateTime @default(now())

  @@unique([userId, questionId, intentVersion])
  @@index([userId])
}

/// A user's execution state for a strategy action. Separate from the
/// deterministic Action template — tracks what the user has actually done.
model UserAction {
  id            String   @id @default(cuid())
  userId        String
  actionId      String
  title         String
  description   String
  status        String   @default("NOT_STARTED")
  startedAt     DateTime?
  completedAt   DateTime?
  blockedReason String?
  strategyEngineVersion String?
  runtimePolicyHash String?
  /// The DecisionRecord that generated this action's prediction. Links each
  /// action to the exact historical strategy that predicted its effect.
  /// N0.4b: required for server-derived prediction provenance.
  decisionRecordId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, actionId])
  @@index([userId])
  @@index([status])
  @@index([decisionRecordId])
}

// ---------------------------------------------------------------------------
// N0.4 — STRATEGY FEEDBACK + OUTCOME TRACKING
// ---------------------------------------------------------------------------

/// User feedback on a specific historical strategy recommendation. Immutable —
/// each feedback event is a separate record. A user can submit multiple
/// feedback events over time for the same DecisionRecord.
///
/// Feedback is the user's subjective assessment of the strategy's quality.
/// It is NOT a factual claim about the outside world — it's the user's
/// perception of how useful/accurate the recommendation was.
model StrategyFeedback {
  id              String   @id @default(cuid())
  userId          String
  /// The exact DecisionRecord this feedback describes. Must belong to this user.
  decisionRecordId String
  /// Overall usefulness (1-5 scale, or null if not rated).
  usefulness      Int?
  /// Did the strategy's assumptions hold? (1-5 or null)
  assumptionAccuracy Int?
  /// Was the explanation accurate? (1-5 or null)
  explanationAccuracy Int?
  /// Were the blockers correctly identified? (1-5 or null)
  blockerAccuracy Int?
  /// Was the confidence assessment appropriate? (1-5 or null)
  confidenceAssessment Int?
  /// Free-text feedback (optional).
  freeText        String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([decisionRecordId])
  @@index([createdAt])
}

/// The observed outcome of a specific user action. Separate from UserAction
/// because one action can have multiple outcomes (attempts, retries) and
/// completion ≠ success.
///
/// Stores the PREDICTED values (immutable — from the original strategy) and
/// the ACTUAL observed values (added separately when reality is known).
///
/// N0.7 OUTCOME INTELLIGENCE:
///   - `outcomeType` is a controlled vocabulary based on real Wayfinder
///     concepts (not free text).
///   - `expectedByDate` records when the outcome was expected to occur.
///   - `confidence` records how confident Wayfinder was in the prediction.
///   - `graphNodeId` links this outcome to the DecisionGraph OUTCOME node.
///   - `evaluationStatus` is the deterministic ACHIEVED/PARTIALLY_ACHIEVED/
///     NOT_ACHIEVED/UNKNOWN result computed from predicted vs actual.
///   - Expected outcomes are auto-created at adoption time (predicted fields
///     only, actual fields null). Observed outcomes are recorded when reality
///     is known. Both are immutable append-only events.
model ActionOutcome {
  id              String   @id @default(cuid())
  userId          String
  /// The exact UserAction this outcome describes. Must belong to this user.
  userActionId    String
  /// The DecisionRecord that contained the prediction. Links to the exact
  /// strategy that predicted the action's effect.
  decisionRecordId String?
  /// N0.7: Controlled vocabulary outcome type. Deterministic — derived from
  /// the historical DecisionGraph at adoption time (authoritative), not text.
  /// Falls back to UNKNOWN when the graph doesn't provide a relationship.
  outcomeType     String   @default("UNKNOWN")
  /// N0.7: The DecisionGraph OUTCOME node this expected outcome corresponds to.
  /// Links the outcome tracking to the explanation graph. Only set when the
  /// node actually exists in the historical graph (validated).
  graphNodeId     String?
  /// N0.7: When the outcome was expected to occur (target date). Derived from
  /// the action's timeframe + the IMMUTABLE historical adoption date.
  expectedByDate  DateTime?
  /// N0.7: @deprecated Numeric confidence. Retained for backward compat with
  /// existing records, but new code must NOT fabricate numeric probabilities.
  /// Use `confidenceLevel` (qualitative) instead.
  confidence      Float?
  /// N0.7: Qualitative confidence level (HIGH/MEDIUM/LOW/UNKNOWN). Never a
  /// fabricated probability. Derived from the strategy's uncertainty
  /// assessments (worst dimension, conservative).
  confidenceLevel String?
  /// N0.7: For OBSERVED outcomes — the exact expected outcome event this
  /// observation evaluates. Explicit causal identity. Nullable for backward
  /// compat with pre-N0.7-hardening records.
  expectedOutcomeId String?
  /// N0.7: Deterministic evaluation status, computed from predicted vs actual.
  /// ACHIEVED | PARTIALLY_ACHIEVED | NOT_ACHIEVED | UNKNOWN
  evaluationStatus String  @default("UNKNOWN")
  /// The predicted effect (from the original strategy, immutable).
  predictedEffect String?
  /// The actual observed effect.
  actualEffect    String?
  /// Predicted duration in months (from the original strategy).
  predictedDurationMonths Float?
  /// Actual duration in months.
  actualDurationMonths     Float?
  /// Predicted cost in USD (from the original strategy).
  predictedCostUSD Float?
  /// Actual cost in USD.
  actualCostUSD    Float?
  /// Whether the predicted blocker was resolved.
  predictedBlockerResolved Boolean?
  /// Whether the blocker was actually resolved.
  actualBlockerResolved    Boolean?
  /// The outcome status.
  status          String   @default("UNKNOWN") // UNKNOWN | OBSERVED | CONFIRMED | USER_REPORTED | EXTERNALLY_VERIFIED | FAILED
  /// Provenance: who/what reported this outcome.
  provenance      String   @default("USER_REPORTED") // USER_REPORTED | SYSTEM_DERIVED | EXTERNALLY_VERIFIED
  /// Free-text notes from the user.
  notes           String?
  /// Idempotency key to prevent duplicate outcomes from retries.
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([userActionId])
  @@index([decisionRecordId])
  @@index([status])
  @@index([provenance])
  @@index([outcomeType])
  @@index([evaluationStatus])
  @@index([expectedOutcomeId])
}

/// The observed outcome of a strategy as a whole. A strategy can be followed
/// without fully completing every action — this captures the trajectory-level
/// result.
///
/// Like ActionOutcome, stores the predicted trajectory state (immutable) and
/// the actual observed state separately.
///
/// N0.7 OUTCOME INTELLIGENCE:
///   - `outcomeType` is a controlled vocabulary based on real Wayfinder
///     concepts (not free text).
///   - `graphNodeId` links this outcome to the DecisionGraph OUTCOME node
///     (the bestTrajectory outcome node).
///   - `confidence` records how confident Wayfinder was in the prediction.
///   - `evaluationStatus` is the deterministic ACHIEVED/PARTIALLY_ACHIEVED/
///     NOT_ACHIEVED/UNKNOWN result computed from predicted vs actual.
///   - Expected outcomes are auto-created at adoption time. Observed outcomes
///     are recorded when reality is known. Both are immutable append-only.
model StrategyOutcome {
  id              String   @id @default(cuid())
  userId          String
  /// The exact DecisionRecord this outcome describes. Must belong to this user.
  decisionRecordId String
  /// The objective this strategy was for.
  objectiveId     String?
  /// N0.7: Controlled vocabulary outcome type. Deterministic — derived from
  /// the historical DecisionGraph (authoritative), not text. Falls back to
  /// UNKNOWN when the graph doesn't provide a relationship.
  outcomeType     String   @default("UNKNOWN")
  /// N0.7: The DecisionGraph OUTCOME node this expected outcome corresponds to.
  /// Only set when the node actually exists in the historical graph (validated).
  graphNodeId     String?
  /// N0.7: @deprecated Numeric confidence. Retained for backward compat.
  /// New code uses `confidenceLevel` (qualitative).
  confidence      Float?
  /// N0.7: Qualitative confidence level (HIGH/MEDIUM/LOW/UNKNOWN). Never a
  /// fabricated probability.
  confidenceLevel String?
  /// N0.7: For OBSERVED outcomes — the exact expected outcome event this
  /// observation evaluates. Explicit causal identity.
  expectedOutcomeId String?
  /// N0.7: Deterministic evaluation status, computed from predicted vs actual.
  /// ACHIEVED | PARTIALLY_ACHIEVED | NOT_ACHIEVED | UNKNOWN
  evaluationStatus String  @default("UNKNOWN")
  /// Whether the strategy was followed.
  strategyFollowed String  @default("UNKNOWN") // UNKNOWN | FOLLOWED | PARTIALLY_FOLLOWED | ABANDONED
  /// Whether the objective was achieved.
  objectiveAchieved String @default("UNKNOWN") // UNKNOWN | ACHIEVED | PARTIALLY_ACHIEVED | NOT_ACHIEVED | SUPERSEDED
  /// Whether the trajectory became viable.
  trajectoryBecameViable String @default("UNKNOWN") // UNKNOWN | YES | NO
  /// Predicted trajectory viability (from the original strategy, immutable).
  predictedTrajectoryViable Boolean?
  /// Actual trajectory viability (observed).
  actualTrajectoryViable    Boolean?
  /// Predicted timeline to destination (months).
  predictedTimelineMonths   Float?
  /// Actual timeline to destination (months).
  actualTimelineMonths      Float?
  /// Predicted total cost (USD).
  predictedTotalCostUSD     Float?
  /// Actual total cost (USD).
  actualTotalCostUSD        Float?
  /// Provenance: who/what reported this outcome.
  provenance      String   @default("USER_REPORTED") // USER_REPORTED | SYSTEM_DERIVED | EXTERNALLY_VERIFIED
  /// Free-text notes.
  notes           String?
  /// Idempotency key to prevent duplicate outcomes from retries.
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([decisionRecordId])
  @@index([objectiveId])
  @@index([strategyFollowed])
  @@index([provenance])
  @@index([outcomeType])
  @@index([evaluationStatus])
  @@index([expectedOutcomeId])
}
