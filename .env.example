# Wayfinder environment variables.
# Copy to .env for local development. On Vercel, set these in the project settings.

# Neon PostgreSQL (pooled for runtime, direct for migrations)
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASS@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Z.ai LLM SDK (optional — deterministic fallbacks apply if unset/unreachable)
ZAI_BASE_URL="https://internal-api.z.ai/v1"
ZAI_API_KEY="Z.ai"
